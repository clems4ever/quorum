# Public host name served by Traefik (no scheme). The Google OAuth client must
# allow https://<QUORUM_HOST>/auth/callback as a redirect URI.
QUORUM_HOST=quorum.example.com

# OAuth client of type "Web application" from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
#QUORUM_TAG=latest                    # or sha-<commit> to pin a build
#SESSION_TTL=720h
#TRAEFIK_NETWORK=traefik              # external network Traefik is attached to
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt

# Demo (compose.demo.yaml) only
#QUORUM_DEMO_HOST=quorum-demo.example.com
